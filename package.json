    "build": "tsc --noEmit && vite build",
    "test": "node --test \"src/tests/**/*.test.mjs\"",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:production": "node scripts/verify-production-config.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "verify:staging-env": "node scripts/validate-staging-env.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:full": "powershell -ExecutionPolicy Bypass -File ./scripts/start-vardhan-full.ps1",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/start-vardhan-backend.ps1"
  },
  "dependencies": {
