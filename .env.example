# Environment variable names only. Never place service-role or provider secrets in VITE_* values.
# REQUIRED NOW FOR STAGING
VITE_DEV_AUTH_BYPASS=false
VITE_APP_MODE=staging
VITE_REPOSITORY_BACKEND=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PLATFORM_API_URL=/api
DATABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
VARDHAN_ENV=staging
CORS_ORIGINS=
RATE_LIMIT_BACKEND=redis
REDIS_URL=
DRAW_ENCRYPTION_KEY=
LICENSE_SIGNING_SECRET=
BACKUP_ENCRYPTION_KEY=

# OPTIONAL FOR STAGING
# Same-origin authenticated server proxy. Never expose OCR provider keys in VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OCR_MAX_FILE_MB=15
OCR_TIMEOUT_SECONDS=30
OCR_MAX_RETRIES=2
OCR_PDF_MAX_PAGES=25
RATE_LIMIT_REDIS_PREFIX=vardhan:rate-limit
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_POOL_MAX=10
ENABLE_API_DOCS=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=
EMAIL_API_URL=https://api.sendgrid.com/v3/mail/send
EMAIL_API_KEY=
EMAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MONITORING_ALERT_WEBHOOK=
MONITORING_ALERT_TOKEN=
LOG_LEVEL=INFO

# PRODUCTION-ONLY ALTERNATIVE. Use only when an approved gateway replaces Redis.
