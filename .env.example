# PROJECT VARDHAN demo deployment environment template
#
# Copy this file to `.env` for local development when needed.
# Do not commit real secrets.

# Local/demo auth bypass.
# Keep false for hosted demos unless you explicitly want local demo bypass behavior.
VITE_DEV_AUTH_BYPASS=false

# Hosted demo mode.
# When this is demo, or Supabase env vars are blank, demo authentication is enabled.
VITE_APP_MODE=demo

# Built-in demo login for hosted demos:
# Email: admin@vardhan.com
# Password: admin123

# Supabase placeholders.
# Supabase is not connected for the current demo deployment stage.
# Leave these blank until the Supabase integration batch is approved.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
